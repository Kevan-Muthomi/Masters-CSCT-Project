              <calculation class='tableau' formula='IF [total_score] &gt;= { FIXED : PERCENTILE([total_score], 0.75) } THEN &quot;High ESG&quot;&#13;&#10;ELSEIF [total_score] &gt;= { FIXED : PERCENTILE([total_score], 0.50) } THEN &quot;Medium-High ESG&quot;&#13;&#10;ELSEIF [total_score] &gt;= { FIXED : PERCENTILE([total_score], 0.25) } THEN &quot;Medium-Low ESG&quot;&#13;&#10;ELSE &quot;Low ESG&quot;&#13;&#10;END' />
