              <table-calc field='[federated.0fh6zvf1hqi7bn15x8idl1uwzl7b].[Calculation_636133465585561602]' ordering-field='[federated.0fh6zvf1hqi7bn15x8idl1uwzl7b].[none:Company_CSR:nk]' ordering-type='Field' />
