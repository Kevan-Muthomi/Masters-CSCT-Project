        <calculation class='tableau' formula='IF [Calculation_636133465585561602] &lt;= SIZE()/4 THEN &quot;Low ESG&quot;&#13;&#10;ELSEIF [Calculation_636133465585561602] &lt;= SIZE()/2 THEN &quot;Medium-Low ESG&quot;&#13;&#10;ELSEIF [Calculation_636133465585561602] &lt;= 3*SIZE()/4 THEN &quot;Medium-High ESG&quot;&#13;&#10;ELSE &quot;High ESG&quot;&#13;&#10;END'>
