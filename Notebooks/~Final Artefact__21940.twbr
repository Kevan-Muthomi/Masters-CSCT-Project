    <worksheet name='Sentiment Intensity by ESG Quartile'>
      <table>
        <view>
          <datasources>
            <datasource caption='final_tableau_dataset' name='federated.0fh6zvf1hqi7bn15x8idl1uwzl7b' />
          </datasources>
          <datasource-dependencies datasource='federated.0fh6zvf1hqi7bn15x8idl1uwzl7b'>
            <column caption='ESG Rank' datatype='integer' name='[Calculation_636133465585561602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK(SUM([total_score]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ESG Quartile' datatype='string' name='[Calculation_636133465585930243]' role='measure' type='nominal'>
