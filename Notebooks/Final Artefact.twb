      <aliases enabled='yes' />
      <column caption='ESG Quartile' datatype='string' name='[Calculation_1316739964432113664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_score] &gt;= { FIXED : PERCENTILE([total_score], 0.75) } THEN &quot;High ESG&quot;&#13;&#10;ELSEIF [total_score] &gt;= { FIXED : PERCENTILE([total_score], 0.50) } THEN &quot;Medium-High ESG&quot;&#13;&#10;ELSEIF [total_score] &gt;= { FIXED : PERCENTILE([total_score], 0.25) } THEN &quot;Medium-Low ESG&quot;&#13;&#10;ELSE &quot;Low ESG&quot;&#13;&#10;END' />
      </column>
      <column caption='CSR-Sentiment Alignment' datatype='string' name='[Calculation_1316739964433010689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [total_score] &gt;= { FIXED : MEDIAN([total_score]) }&#13;&#10;AND [avg_sentiment] &gt;= { FIXED : MEDIAN([avg_sentiment]) }&#13;&#10;THEN &quot;Aligned&quot;&#13;&#10;ELSE &quot;Misaligned&quot;&#13;&#10;END' />
      </column>
      <column caption='Engagement Weight' datatype='real' name='[Calculation_1316739964433321986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([post_count] + 1)' />
      </column>
